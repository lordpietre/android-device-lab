{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "skill": { "android-device-lab": "allow" },
    "bash": {
      "*": "ask",
      "adb devices*": "allow",
      "adb get-state*": "allow",
      "adb -s * get-state*": "allow",
      "adb shell getprop*": "allow",
      "adb -s * shell getprop*": "allow",
      "bash scripts/device-info.sh*": "allow",
      "bash scripts/firmware-triage.sh*": "allow",
      "bash scripts/lint.sh*": "allow",
      "fastboot devices*": "allow",
      "fastboot getvar*": "allow",
      "fastboot -s * getvar*": "allow",
      "bash scripts/setup-host.sh*": "ask",
      "bash scripts/backup-partitions.sh*": "ask",
      "sudo *": "ask",
      "adb reboot*": "ask",
      "adb install*": "ask",
      "adb sideload*": "ask",
      "adb shell settings*": "ask",
      "adb shell su*": "ask",
      "fastboot boot*": "ask",
      "fastboot flash*": "ask",
      "fastboot flashing*": "ask",
      "fastboot oem*": "ask",
      "fastboot reboot*": "ask",
      "fastboot set_active*": "ask",
      "fastboot update*": "ask",
      "pmbootstrap flasher flash*": "ask",
      "pmbootstrap install*": "ask",
      "mtk flash*": "ask",
      "rm -rf*": "ask",
      "fastboot erase*": "deny",
      "fastboot format*": "deny",
      "fastboot flashing lock*": "deny",
      "fastboot flash bootloader*": "deny",
      "fastboot flash aboot*": "deny",
      "fastboot flash abl*": "deny",
      "fastboot flash xbl*": "deny",
      "fastboot flash sbl*": "deny",
      "fastboot flash tz*": "deny",
      "fastboot flash hyp*": "deny",
      "fastboot flash modem*": "deny",
      "fastboot flash radio*": "deny",
      "fastboot flash preloader*": "deny",
      "fastboot flash persist*": "deny",
      "fastboot flash efs*": "deny",
      "fastboot flash nvram*": "deny",
      "fastboot flash nvdata*": "deny",
      "fastboot flash frp*": "deny",
      "fastboot flash rpmb*": "deny",
      "adb shell dd *of=/dev/block*": "deny",
      "dd *of=/dev/*": "deny"
    }
  }
}
